# Story Service — local environment template
# Copy to .env and fill values. NEVER commit .env or service account JSON.

# ============================================
# Required — image / story generation
# ============================================
GOOGLE_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-...   # only if STORY_MODEL_PROVIDER=openai
# STORY_MODEL_PROVIDER=openai
# STORY_MODEL=gpt-5.6-terra

IMAGE_PROVIDER=laozhang
API_KEY_LAOZHANG=your-laozhang-api-key
# LAOZHANG_API_BASE=https://api2.laozhang.ai
# LAOZHANG_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ============================================
# Required — Cloud Run job persistence
# ============================================
JOBS_BUCKET=imgstr-story-jobs-us-central1
# STORY_JOBS_BUCKET=   # alias for JOBS_BUCKET

# ============================================
# Optional — email delivery from API jobs
# ============================================
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=team@img2x.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=team@img2x.com
# SMTP_FROM_NAME=IMG2X

# ============================================
# Optional — tuning
# ============================================
# IMAGE_CONCURRENCY=16
# IMAGE_MAX_ATTEMPTS=6
# LaoZhang Default-group $0.03/call. Documented host is api2.
# Primary: LaoZhang 2.5 VIP ($0.03). Backup: official OpenAI (IMAGE_API_FALLBACK=1).
# IMAGE_API_BASE=https://api2.laozhang.ai/v1
# IMAGE_API_FALLBACK=1
# Digital (cheaper SKU): 1024 + Flare medium pages. Hardcover: Sunburst high 2048.
# IMAGE_MODEL=gpt-image-2.5-sunburst-vip
# IMAGE_MODEL_PAGES=gpt-image-2.5-flare-vip
# IMAGE_MODEL_PRINT=gpt-image-2.5-sunburst-vip
# IMAGE_QUALITY=high
# IMAGE_QUALITY_PAGES=medium
# IMAGE_QUALITY_PRINT=high
# IMAGE_SIZE=1024x1024
# IMAGE_SIZE_PRINT=2048x2048
# SIGNED_URL_EXPIRES_DAYS=7
# INLINE_IMAGE_MAX_BYTES=1200000

# Local Google credentials (choose one)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
