# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore.

# Node modules - installed during Docker build
node_modules/

# Development files
.git/
.gitignore
.env
.env.local
.env.development
.env.test

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (rebuilt in Docker)
.next/
out/
dist/

# Test files
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__/

# Documentation
*.md
!README.md

# Misc
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Terraform state (should never be uploaded)
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform/
